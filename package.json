{
  "name": "markdown-office-preview",
  "displayName": "markdown-office-preview",
  "description": "vscode-pulgin-markdown-office-preview",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "markdown-office-preview",
      "properties": {
        "mdPandocWordPreview.pandocPath": {
          "type": "string",
          "default": "",
          "description": "pandoc可执行文件路径，优先环境变量PATH，找不到在此手动填写"
        },
        "mdPandocWordPreview.sofficePath": {
          "type": "string",
          "default": "",
          "description": "LibreOffice soffice.exe 路径，windows示例 C:\\Program Files\\LibreOffice\\program\\soffice.exe"
        },
        "mdPandocWordPreview.referenceDocPath": {
          "type": "string",
          "default": "",
          "description": "pandoc reference-doc模板docx路径，用于固定Word样式（公文/论文模板）"
        },
        "mdPandocWordPreview.pandocExtraArgs": {
          "type": "string",
          "default": "",
          "description": "pandoc额外参数，如 --csl xxx.csl 参考文献格式"
        },
        "mdPandocWordPreview.debounceMs": {
          "type": "number",
          "default": 800,
          "description": "防抖延迟，输入后等待多少毫秒执行转换，防止频繁调用pandoc"
        },
        "mdPandocWordPreview.autoOverwrite": {
          "type": "boolean",
          "default": false,
          "description": "是否自动覆盖已存在的docx/pdf，关闭则弹窗询问"
        },
        "mdPandocWordPreview.preferThirdPartyViewer": {
          "type": "boolean",
          "default": true,
          "description": "优先复用已安装第三方PDF预览插件(LaTeX-Workshop / pdfviewer); false强制使用内置预览面板"
        }
      }
    },
    "commands": [
      {
        "command": "md-pandoc-word-preview.openPreview",
        "title": "Open Pandoc Word Preview(PDF)",
        "icon": {
          "light": "./images/markpandocview.svg",
          "dark": "./images/markpandocview.svg"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "md-pandoc-word-preview.openPreview"
        }
      ],
      "editor/title": [
        {
          "command": "md-pandoc-word-preview.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/pdfjs-dist": "^2.10.378",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "execa": "^8.0.1",
    "pdfjs-dist": "^6.4.299"
  }
}
